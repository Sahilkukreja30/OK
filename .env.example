# ---- Admin dashboard (/admin) – server-side only, never prefix with VITE_ ----

# Password for signing in at /admin
ADMIN_PASSWORD=
# Separate random secret used to sign admin sessions (openssl rand -base64 32). Defaults to ADMIN_PASSWORD.
ADMIN_SESSION_SECRET=

# Storage: nothing to configure locally – `npm run dev` keeps content as files in ./.data.
# On Vercel: project -> Storage -> Create Storage -> Blob (Public). Vercel adds BLOB_STORE_ID and
# BLOB_READ_WRITE_TOKEN for you. (Only set a token by hand to point a local run at the real store.)
# BLOB_READ_WRITE_TOKEN=

# Public site address used in sitemap.xml (defaults to the request host)
SITE_URL=
