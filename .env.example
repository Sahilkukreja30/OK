# ---- Admin dashboard (/admin) – server-side only, never prefix with VITE_ ----

# Password for signing in at /admin
ADMIN_PASSWORD=
# Optional: separate secret for signing admin sessions (defaults to ADMIN_PASSWORD)
ADMIN_SESSION_SECRET=

# Contentful Management API token (Settings > API keys > Content management tokens).
# Needed to create/edit/publish entries and upload images.
CONTENTFUL_MANAGEMENT_TOKEN=
CONTENTFUL_SPACE_ID=ogzk8tbw9009
CONTENTFUL_ENVIRONMENT=master
# Delivery token used by the sitemap (same value the site already uses)
CONTENTFUL_DELIVERY_TOKEN=

# Public site address used in sitemap.xml (defaults to the request host)
SITE_URL=

# ---- Public site (already supported; defaults are built in) ----
# VITE_CONTENTFUL_SPACE_ID=
# VITE_CONTENTFUL_ACCESS_TOKEN=
# VITE_CONTENTFUL_ENVIRONMENT=master
